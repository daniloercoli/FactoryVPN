FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY api/ ./api/
COPY factoryvpn_common/ ./factoryvpn_common/
COPY pyproject.toml .env.example ./
ARG FACTORYVPN_BUILD_ID=unknown
ENV FACTORYVPN_BUILD_ID=$FACTORYVPN_BUILD_ID
ARG APP_NAME=FactoryVPN
ENV APP_NAME=$APP_NAME
COPY scripts/ ./scripts/
COPY alembic.ini ./
COPY migrations/ ./migrations/

# Expose port
EXPOSE 8000

# Run
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn api.main:app --host 0.0.0.0 --port 8000 --no-access-log"]

FROM node:24-alpine AS portal-build
WORKDIR /build
COPY portal/package.json portal/package-lock.json ./
RUN npm ci
COPY portal/ ./
ARG APP_NAME=FactoryVPN
ENV APP_NAME=$APP_NAME
RUN npm run build

FROM nginx:stable-alpine
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/factory-allow.conf /etc/nginx/factory-allow.conf
COPY --from=portal-build /build/dist/ /usr/share/nginx/html/app/

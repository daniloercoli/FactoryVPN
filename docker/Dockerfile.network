FROM python:3.12-slim AS runtime
WORKDIR /app
ENV PYTHONPATH=/app
RUN apt-get update && apt-get install -y --no-install-recommends openvpn nftables iproute2 iputils-ping procps && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY factoryvpn_common/ ./factoryvpn_common/
COPY pyproject.toml ./
ARG FACTORYVPN_BUILD_ID=unknown
ENV FACTORYVPN_BUILD_ID=$FACTORYVPN_BUILD_ID
COPY session-worker/ ./session-worker/
COPY gateway-agent/ ./gateway-agent/
COPY api/__init__.py ./api/__init__.py
COPY api/schemas/ ./api/schemas/
COPY docker/openvpn/ /etc/openvpn/
FROM runtime AS test
RUN pip install --no-cache-dir pytest==7.4.4 pytest-asyncio==0.23.3
COPY api/ ./api/
COPY scripts/ ./scripts/
COPY tests/ ./tests/
COPY pyproject.toml ./
CMD ["python", "tests/network_smoke.py"]

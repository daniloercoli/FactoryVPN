SERVER_URL=https://vpn.example.com
# UUID generato dal portale FactoryVPN, associato al certificato VPN.
GATEWAY_ID=
# sms è la modalità predefinita; wifi non richiede SIM o modem.
GATEWAY_ACTIVATION_MODE=sms
# Obbligatorio solo per SMS, lasciare vuoto per Wi-Fi.
GATEWAY_PHONE_NUMBER=+393331234567
# Credenziale HTTPS individuale consegnata dal portale.
GATEWAY_API_KEY=
# Segreto distinto per la firma SMS, nello stesso pacchetto protetto.
GATEWAY_SMS_KEY=
MODEM_PATH=/dev/ttyUSB0
# MAC registrato: obbligatorio per Wi-Fi, facoltativo per SMS.
MAC_ADDRESS=AA:BB:CC:DD:EE:FF
# Inventario facoltativo; si rileva il MAC radio solo su interfacce wireless verificate.
GATEWAY_WIFI_INTERFACE=
GATEWAY_HARDWARE_MODEL=
GATEWAY_HARDWARE_REVISION=
VPN_INTERFACE=tun0
OPENVPN_CONFIG=/etc/factoryvpn/gateway.ovpn
# Pausa tra controlli modem SMS e heartbeat della sessione attiva (1-10 secondi).
GATEWAY_POLL_INTERVAL=5
# Polling HTTPS in attesa, solo Wi-Fi (5-300 secondi).
GATEWAY_WIFI_CHECK_INTERVAL=30
# Timeout HTTP per fase degli heartbeat (1-60 secondi), non tolleranza complessiva.
CONTROL_API_TIMEOUT_SECONDS=10
# Attesa iniziale dell'avvio/riconnessione OpenVPN (5-300 secondi).
GATEWAY_CONNECT_TIMEOUT_SECONDS=30
# Il server decide il lease (default 300 s): un guasto API non lo prolunga.
# Durata VPN, lease e keepalive si configurano nel .env del server.

SERVER_URL=https://vpn.example.com
# UUID generated by the FactoryVPN portal; matches the VPN certificate.
GATEWAY_ID=
# sms is the primary/default activation mode. wifi requires no SIM or modem.
GATEWAY_ACTIVATION_MODE=sms
# Required only for sms. For wifi leave empty.
GATEWAY_PHONE_NUMBER=+393331234567
# Individual HTTPS credential delivered by the portal.
GATEWAY_API_KEY=
# Separate SMS signature secret, delivered in the same protected package.
GATEWAY_SMS_KEY=
MODEM_PATH=/dev/ttyUSB0
# Required for wifi, optional for sms. This is the registered MAC, with no inferred role.
MAC_ADDRESS=AA:BB:CC:DD:EE:FF
# Optional inventory: only an interface verified as wireless is reported as Wi-Fi.
GATEWAY_WIFI_INTERFACE=
GATEWAY_HARDWARE_MODEL=
GATEWAY_HARDWARE_REVISION=
LAN_INTERFACE=eth0
LAN_ADDRESS=192.168.1.1
LAN_CIDR=192.168.1.0/24
VPN_INTERFACE=tun0
OPENVPN_CONFIG=/etc/factoryvpn/gateway.ovpn
# SMS modem check and active-session heartbeat, 1-10 seconds.
GATEWAY_POLL_INTERVAL=5
# Idle Wi-Fi HTTPS check, 5-300 seconds.
GATEWAY_WIFI_CHECK_INTERVAL=30

# Generare .env e PKI privata con: python -m scripts.bootstrap init --host vpn.example.com
# Il comando compila i segreti e conserva questi commenti. Non versionare il .env reale.
# Guida: documentation/DOCKER_GUIDE.md#durate-timeout-e-reti-instabili
POSTGRES_PASSWORD=
JWT_SECRET=
WORKER_API_KEY=
# Chiave di cifratura per i pacchetti temporanei e i segreti SMS, generata dal bootstrap.
PROVISIONING_SECRET_KEY=
# Tempo disponibile per scaricare un pacchetto di provisioning (1-60 minuti).
PROVISIONING_DOWNLOAD_MINUTES=15
# FINE LINEA opzionale: {} disabilita le postazioni. Solo hash SHA-256, mai chiavi in chiaro.
# Configurare con scripts.factory_access; Nginx richiede anche IP esplicitamente fidati.
# Le API del gateway usano invece una credenziale individuale, senza vincolo sull'IP.
FACTORY_STATIONS={}
FACTORY_REQUESTS_PER_MINUTE=60
ENROLLMENT_REQUESTS_PER_MINUTE=30
ENROLLMENT_PACKAGES_PER_HOUR=6
ENVIRONMENT=production
FACTORYVPN_RUNTIME_DIR=./.runtime
OPENVPN_SERVER_HOST=vpn.example.com
OPENVPN_SERVER_PORT=1194
HTTP_PORT=80
HTTPS_PORT=443

# DURATE DI ACCESSO (minuti). Nessun rinnovo automatico della scadenza totale.
# VPN: 180 = 3 ore dalla richiesta, inclusa l'attesa iniziale; intervallo 1-720.
# Vale comunque la scadenza più vicina fra VPN, login portale e accesso SSO.
VPN_SESSION_MINUTES=180
# Login al portale: 720 = 12 ore, intervallo 1-720. Il logout chiude le VPN associate.
PORTAL_SESSION_MINUTES=720
# Limite dell'accesso SSO (1-720 minuti), ulteriormente ridotto dai token del provider.
SSO_SESSION_MINUTES=720

# CONTINUITÀ DELLA VPN (secondi).
# Lease: autorizzazione del firewall rinnovata solo dopo controlli API riusciti.
# 300 = fino a 5 minuti dall'ultimo rinnovo; intervallo 30-900 (15 minuti).
# Un errore temporaneo NON azzera il contatore e NON concede altri 5 minuti.
# Logout, revoca e rifiuti espliciti bloccano appena ricevuti; se le API non sono
# raggiungibili, il blocco può attendere la scadenza del lease già concesso.
# La scadenza della VPN/login/SSO può abbreviare questo tempo. Nessuna nuova VPN offline.
VPN_LEASE_SECONDS=300
# Pausa dopo ciascun ciclo del worker server (1-10 secondi). Non è la durata della VPN.
WORKER_POLL_INTERVAL=5
# Pausa tra heartbeat del gateway attivo e controlli modem SMS (1-10 secondi).
# I valori gateway sono copiati nei nuovi gateway.env: non aggiornano dispositivi già installati.
GATEWAY_POLL_INTERVAL=5
# Polling HTTPS del gateway Wi-Fi senza sessione attiva (5-300 secondi).
GATEWAY_WIFI_CHECK_INTERVAL=30
# Timeout HTTP per fase (connessione/lettura/scrittura/pool) degli heartbeat e
# delle richieste del worker (1-60 secondi). Il tempo trascorso consuma il lease.
# Lasciare margine: lease molto maggiore di timeout e intervalli di polling.
CONTROL_API_TIMEOUT_SECONDS=10
# Attesa dell'avvio/riconnessione OpenVPN sul gateway (5-300 secondi).
# Non interrompe ogni 30 secondi una VPN già funzionante.
GATEWAY_CONNECT_TIMEOUT_SECONDS=30
# Ping OpenVPN in assenza di traffico (1-60 secondi).
OPENVPN_PING_SECONDS=10
# Dopo questa assenza di pacchetti, il client tenta la riconnessione (30-900 secondi).
# Almeno il doppio del ping; 300 = 5 minuti. Il server attende il doppio (600 s).
# È distinto dal lease: senza rete i pacchetti non passano e SSH può avere propri timeout.
OPENVPN_RESTART_SECONDS=300

# SSO opzionale: {} lo disabilita. Cognito resta da validare con un provider reale.
# Guida: documentation/DOCKER_GUIDE.md#sso-opzionale. Non versionare chiavi o segreti.
SSO_PROVIDERS={}
SSO_PUBLIC_URL=
SSO_TOKEN_KEY=
SSO_CLIENT_REDIRECT_URIS=["http://127.0.0.1:8765/callback"]
# Verifica della revoca presso il provider, quando abilitata (5-300 secondi).
SSO_CHECK_INTERVAL_SECONDS=60
# Validità dell'ultima verifica riuscita (10-600 secondi, almeno due intervalli).
# Questo limite resta indipendente: con verifica SSO attiva, 120 s possono ridurre
# i 300 s del lease. Aumentarlo solo secondo la politica del provider/azienda.
SSO_MAX_STALENESS_SECONDS=120

# Portale: origin HTTPS esatta, senza slash finale. Vuoto disabilita il login browser.
# /app/ e /api/ devono condividere l'origin, uguale a SSO_PUBLIC_URL se si usa SSO.
PORTAL_PUBLIC_URL=

# generic: token Bearer e JSON {"to": "+...", "message": "..."}; un 2xx accetta l'SMS.
# twilio: usa invece le credenziali Twilio sottostanti.
SMS_PROVIDER=generic
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Solo sviluppo nativo: i container ricavano l'URL del database da POSTGRES_PASSWORD.
# DATABASE_URL=postgresql+asyncpg://factoryvpn:<password>@127.0.0.1:5432/factoryvpn

# Backup sull'host: eseguire init del coordinatore prima del primo avvio Compose.
# init scrive UID/GID dell'operatore, condivisi da API e servizio di provisioning.
FACTORYVPN_UID=1000
FACTORYVPN_GID=1000
BACKUP_MAX_BYTES=536870912
# COMPOSE_PROJECT_NAME=factoryvpn
# Sviluppo nativo: BACKUP_CONTROL_DIR / BACKUP_ARCHIVE_DIR sono percorsi sul server.
# Certificati pubblici PEM per lo stato del server; Compose configura i mount.
# STATUS_HTTPS_CERTIFICATE_FILE=
# STATUS_VPN_CERTIFICATE_FILE=
# STATUS_VPN_CA_FILE=
# La chiave di recupero rimane solo sull'host, mai nell'ambiente delle API.

# Verifica email con SMTP locale: documentation/DOCKER_GUIDE.md#server-smtp-locale.
# Obbligatoria per gli account locali privilegiati. EMAIL_CODE_KEY nasce dal bootstrap.
EMAIL_CODE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# CA privata facoltativa: montarla in sola lettura e indicare il percorso nel container.
SMTP_CA_FILE=

# Validità dei certificati VPN; distinta dalla durata delle sessioni.
VPN_GATEWAY_CERTIFICATE_DAYS=3650
VPN_TECHNICIAN_CERTIFICATE_DAYS=3650

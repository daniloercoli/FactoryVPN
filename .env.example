# Generate an actual .env and private PKI with:
# python -m scripts.bootstrap init --host vpn.example.com
# Never reuse the examples below as secrets. Compose refuses empty required values.
POSTGRES_PASSWORD=
JWT_SECRET=
WORKER_API_KEY=
# Encryption key for temporary provisioning bundles and SMS secrets; generated by bootstrap.
PROVISIONING_SECRET_KEY=
PROVISIONING_DOWNLOAD_MINUTES=15
ENVIRONMENT=production
# SSO is disabled until configured. Cognito connector: WIP, live validation pending.
# See documentation/DOCKER_GUIDE.md#sso-opzionale; keep client secrets and keys out of version control.
SSO_PROVIDERS={}
SSO_PUBLIC_URL=
SSO_TOKEN_KEY=
SSO_CLIENT_REDIRECT_URIS=["http://127.0.0.1:8765/callback"]
SSO_SESSION_MINUTES=30
SSO_CHECK_INTERVAL_SECONDS=60
SSO_MAX_STALENESS_SECONDS=120
FACTORYVPN_RUNTIME_DIR=./.runtime
OPENVPN_SERVER_HOST=vpn.example.com
OPENVPN_SERVER_PORT=1194
HTTP_PORT=80
HTTPS_PORT=443

# generic: Bearer token + JSON {"to": "+...", "message": "..."}; a 2xx accepts the message.
# twilio: use the Twilio credentials below instead.
SMS_PROVIDER=generic
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Native development only; containers derive their DB URL from POSTGRES_PASSWORD.
# DATABASE_URL=postgresql+asyncpg://factoryvpn:<password>@127.0.0.1:5432/factoryvpn

# Web portal: empty disables browser authentication. Exact HTTPS origin, no trailing slash.
# Serve /app/ and /api/ on this same origin. With SSO, it must equal SSO_PUBLIC_URL.
PORTAL_PUBLIC_URL=
PORTAL_SESSION_MINUTES=30

# Host backup coordinator: run its init command before the first Compose start.
# init writes the UID/GID of its operator; API and issuer use the same ownership.
FACTORYVPN_UID=1000
FACTORYVPN_GID=1000
BACKUP_MAX_BYTES=536870912
# COMPOSE_PROJECT_NAME=factoryvpn
# Native development only: BACKUP_CONTROL_DIR / BACKUP_ARCHIVE_DIR are server paths.
# Native certificate status: paths to public PEMs, not private keys; Compose supplies mounts.
# STATUS_HTTPS_CERTIFICATE_FILE=
# STATUS_VPN_CERTIFICATE_FILE=
# STATUS_VPN_CA_FILE=
# The recovery encryption key is host-only, never an API environment variable.

# Email second-step verification. Local SMTP, no SES. See documentation/DOCKER_GUIDE.md#server-smtp-locale.
# Required for privileged local accounts; EMAIL_CODE_KEY is generated by bootstrap.
EMAIL_CODE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional private CA: mount read-only and use its container path here.
SMTP_CA_FILE=
